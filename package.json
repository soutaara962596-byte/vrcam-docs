{
  "name": "vrcam-docs-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-repository.mjs && node scripts/check-git-publication.mjs --ref=HEAD",
    "select": "node scripts/select.mjs",
    "pr": "node scripts/pr.mjs"
  },
  "dependencies": {
    "astro": "7.3.2",
    "marked": "18.0.13",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.1"
  }
}
